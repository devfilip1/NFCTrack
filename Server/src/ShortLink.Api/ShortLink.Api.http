@host = https://localhost:7172
@email = filipi@example.com
@password = Senha123!

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### List links without token (expect 401)
GET {{host}}/api/links

### List links with token (expect 200)
GET {{host}}/api/links
Authorization: Bearer {{login.response.body.$.accessToken}}

### Create link with token (expect 201)
POST {{host}}/api/links
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "destinationUrl": "https://example.com"
}

### Wrong password (expect 401)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "Errada123!"
}

### Weak password (expect 400)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "outro@example.com",
  "password": "123"
}
